---
// src/layouts/CustomLayout.astro
const { title = "v. o. kapelman online" } = Astro.props.frontmatter || Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <script is:inline>
      const theme = localStorage.getItem('starlight-theme') || 
        (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', theme);
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="custom-body-canvas">
    
    <div class="layout-centering-shield">
      <main class="custom-layout-wrapper">
        <slot />
      </main>
    </div>

  </body>
</html>

<style>
  @import "../styles/standalone.css";

  .custom-body-canvas {
    background-color: var(--color-page-bg) !important;
    color: var(--color-page-text) !important;
    min-height: 100vh;
    margin: 0;
  }

  .layout-centering-shield {
    display: flex !important;
    justify-content: center !important;
    width: 100% !important;
    padding-left: 2rem !important;
    padding-right: 2rem !important;
  }

  @utility custom-layout-wrapper {
    @apply prose max-w-4xl w-full block;
    margin: 5rem 0 !important; 
  }

  /* Force typography definitions to follow the master theme state mapping */
  :global(html) .custom-layout-wrapper,
  :global(html[data-theme="dark"]) .custom-layout-wrapper {
    @apply prose-invert;
  }
  :global(html[data-theme="light"]) .custom-layout-wrapper {
    @apply prose-none;
  }

  /* Scoped layout injections matching your preferred contrast targets */
  .custom-layout-wrapper :global(h2),
  .custom-layout-wrapper :global(h3) {
    color: var(--color-page-accent) !important;
    font-weight: 900 !important;
    margin-top: 2.5rem !important;
    margin-bottom: 1.25rem !important;
  }

  .custom-layout-wrapper :global(p) {
    color: var(--color-page-gray) !important;
    line-height: 1.75 !important;
  }

  .custom-layout-wrapper :global(a) {
    color: var(--color-page-accent-high) !important;
    text-decoration: underline !important;
    text-underline-offset: 4px;
  }

  .custom-layout-wrapper :global(hr) {
    border-color: var(--color-page-border) !important;
    margin: 3rem 0 !important;
  }
</style>
