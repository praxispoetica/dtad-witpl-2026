---
// src/components/HeaderLinks.astro
import DefaultSocialIcons from '@astrojs/starlight/components/SocialIcons.astro';
import type { Props } from '@astrojs/starlight/props';
import { Icon } from 'astro-icon/components';


const pathname = Astro.url.pathname;
const isActive = (href: string) => {
  return pathname === href || pathname === href.replace(/\/$/, '');
};
---

<div class="header-nav-wrapper">
  <nav class="text-links">
    <a href="/about/" title="About v. o. kapelman" alt="About v. o. kapelman" aria-current={isActive('/about/') ? 'page' : undefined}>About</a>
    <a href="/writings/" aria-current={isActive('/writings/') ? 'page' : undefined}>Writings</a>
    <a href="/praxispoetica/" title="PraxisPoetica Writing Process notes" alt="PraxisPoetica Writing Process notes" aria-current={isActive('/praxispoetica/') ? 'page' : undefined}>PraxisPoetica</a>
    <a href="/blog/" aria-current={isActive('/blog/') ? 'page' : undefined}>Blog</a> 
    <a href="https://vokapelman.com" title="v. o. kapelman contact and social links" alt="v. o. kapelman contact and social links" target="_blank" rel="noopener noreferrer" class="menu-link">
      Contact
      <Icon name="lucide:external-link" class="icon-inline" />
    </a>
  </nav>
  
  <div class="social-icons-hover-fix">
    <DefaultSocialIcons {...Astro.props} />
  </div>
</div>

<style>
  .header-nav-wrapper {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .text-links {
    display: flex;
    gap: 1.25rem;
  }
  .text-links a {
    color: var(--sl-color-text-muted);
    text-decoration: none;
    font-size: var(--sl-text-sm);
    font-weight: 500;
    transition: color 0.15s ease-in-out;
  }
  .text-links a:hover {
    color: var(--sl-color-accent);
  }
  .text-links a[aria-current="page"] {
    color: var(--sl-color-accent);
    font-weight: 600;
  }

  .menu-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  /* --- FIXING THE SOCIAL LINKS HOVER EFFECT --- */
  .social-icons-hover-fix :global(a) {
    color: var(--sl-color-text-muted);
    transition: color 0.15s ease-in-out;
  }
  
  .social-icons-hover-fix :global(a:hover) {
    /* Uses your brand's dark-mode/light-mode accent color on hover */
    color: var(--sl-color-accent) !important; 
  }
</style>
